_projects_logged_this_run = set()


def configure_logging(project_name):
    """(Re)configure the module-level logger for the given project.

    Sets the global PROJECT_NAME / project_dir, points the file handler at
    that project's own log file, and attaches a StringIO handler that
    captures the same INFO-level lines shown on the console so they can be
    saved to a per-project text file at the end of the run.
    """
    global PROJECT_NAME, project_dir, console_log_buffer

    PROJECT_NAME = project_name
    project_dir = os.path.join(EXPORT_DIR, PROJECT_NAME)
    os.makedirs(project_dir, exist_ok=True)

    is_first_call_this_run = project_name not in _projects_logged_this_run
    file_mode = 'w' if is_first_call_this_run else 'a'

    console_handler = logging.StreamHandler()
    console_handler.setLevel(logging.INFO)
    console_handler.addFilter(InfoFilter())
    console_handler.setFormatter(logging.Formatter('%(asctime)s - %(levelname)s - %(message)s'))

    # 'w' the first time this project is configured in this run (fresh log,
    # same as before), 'a' on any later call in the SAME run (e.g.
    # run_pipeline_followups() re-configuring after run_pipeline already
    # ran for this project) so earlier lines are not erased.
    file_handler = logging.FileHandler(os.path.join(project_dir, 'git_stability_results.log'), mode=file_mode, encoding='utf-8')
    file_handler.setLevel(logging.INFO)
    file_handler.setFormatter(logging.Formatter('%(asctime)s - %(levelname)s - %(message)s'))

    # Captures exactly what the console shows, so it can be dumped to
    # "Result (<project>) Log.txt" once this project's run is complete.
    # Always starts EMPTY on every call (even the 'a' case above) -
    # save_console_log_to_file() below appends its content to the existing
    # file rather than this buffer accumulating across calls itself.
    console_log_buffer = io.StringIO()
    buffer_handler = logging.StreamHandler(console_log_buffer)
    buffer_handler.setLevel(logging.INFO)
    buffer_handler.addFilter(InfoFilter())
    buffer_handler.setFormatter(logging.Formatter('%(asctime)s - %(levelname)s - %(message)s'))

    if logger.hasHandlers(): logger.handlers.clear()
    logger.addHandler(console_handler)
    logger.addHandler(file_handler)
    logger.addHandler(buffer_handler)


def log_progress(prefix, current, total, start_time):
    """Log a 'N/total (pct%) | elapsed | ETA' line.

    Deliberately goes through `logger` (not tqdm/print) so it shows up in
    the console, in git_stability_results.log, AND in the per-project
    'Result (<project>) Log.txt' dump - tqdm's carriage-return-based bar
    would not be captured by any of the three.
    """
    elapsed = time.time() - start_time
    pct = 100.0 * current / total if total else 0.0
    rate = elapsed / current if current else 0.0
    eta = rate * (total - current) if current else float('nan')
    logger.info(f"[progress] {prefix}: {current}/{total} ({pct:5.1f}%) | "
                f"elapsed {elapsed:7.1f}s | ETA {eta:7.1f}s")


def save_console_log_to_file():
    """Write everything printed to the console during this project's current
    logging segment to 'Result (<project name>) Log.txt' in the project's
    output folder. The first time this is called for a project in this run
    it overwrites (fresh file); any later call for the SAME project (e.g.
    once more after run_pipeline_followups()) appends, so the file ends up
    containing the full run (main comparison + follow-up analyses) instead
    of only whichever pass happened to save last."""
    global _projects_logged_this_run
    log_path = os.path.join(project_dir, f"Result ({PROJECT_NAME}) Log.txt")
    is_first_write_this_run = PROJECT_NAME not in _projects_logged_this_run
    mode = 'w' if is_first_write_this_run else 'a'
    with open(log_path, mode, encoding="utf-8") as f:
        f.write(console_log_buffer.getvalue())
    _projects_logged_this_run.add(PROJECT_NAME)
    logger.info(f"Console log saved to: {log_path}")


